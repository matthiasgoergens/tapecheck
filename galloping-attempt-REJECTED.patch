@@ -580,18 +602,35 @@ let shrink (type a) ~tape ~(gen : a Base_quickcheck.Generator.t) ~size
                   | Some (Tape.Integer { value; lo; hi })
                     when Int64.(value <> clamp64 0L ~lo ~hi)
