                 let jj = !j + offset in
+                (* Galloping descent. This used to step the value by ONE
+                   per attempt, which costs O(value) attempts to drive an
+                   element to its target -- 100 attempts for a value of
+                   100, per element. Measured, that made this the single
+                   dominant cost in the engine: 612 of 641 attempts on
