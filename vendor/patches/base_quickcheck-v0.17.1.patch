+let recursive_with_max_leaves
+  ?(max_leaves = 100)
+  ?(max_attempts = 1_000)
+  base
+  ~f
+  =
+  if max_leaves <= 0
+  then
+    raise_s
+      [%message
+        "Base_quickcheck.Generator.recursive_with_max_leaves: max_leaves <= 0"
+          (max_leaves : int)];
+  if max_attempts <= 0
