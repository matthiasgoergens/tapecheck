; vendor-study holds throwaway upstream clones for reading only.
(dirs :standard \ vendor-study)

; bonsai-tapecheck-hunt is a self-contained consumer workspace (own
; dune-project, own pins of the splittable_random/base_quickcheck shims);
; building it from here would clash with vendor/'s library names. It must
; be data_only, not just excluded from (dirs): its nested dune-project
; would otherwise still pull it into this build as a second project.
(data_only_dirs bonsai-tapecheck-hunt)

; The consumer is intentionally a copied, package-shaped workspace. A green
; run there is evidence about this tree only while those source copies match.
(rule
 (alias runtest)
 (deps
  scripts/check_consumer_snapshot.sh
  scripts/sync_consumer_snapshot.sh
  (source_tree engine)
  (source_tree tape)
  (source_tree vendor/splittable_random)
  (source_tree vendor/sr_real)
  (source_tree vendor/base_quickcheck)
  (source_tree vendor/ppx_quickcheck)
  (source_tree vendor/ppx_quickcheck_expander)
  (source_tree vendor/ppx_quickcheck_runtime)
  (source_tree bonsai-tapecheck-hunt/engine)
  (source_tree bonsai-tapecheck-hunt/pkgs/splittable_random/src)
  (source_tree bonsai-tapecheck-hunt/pkgs/base_quickcheck/src)
  (source_tree bonsai-tapecheck-hunt/pkgs/base_quickcheck/ppx_quickcheck)
  (source_tree bonsai-tapecheck-hunt/pkgs/base_quickcheck/expander)
  (source_tree bonsai-tapecheck-hunt/pkgs/base_quickcheck/runtime))
 (action (run sh %{dep:scripts/check_consumer_snapshot.sh})))

; Fail fast on profile/compiler mismatches: an OxCaml switch without
; --profile oxcaml would miscompile the ppx pieces against a divergent
; parsetree, and --profile oxcaml on a stock switch would silently drop
; the test suites and demo from the build graph.
(rule
 (alias default)
 (enabled_if
  (<> %{profile} oxcaml))
 (action
  (run sh -c
    "case \"$(ocamlc -version)\" in *+ox*) echo 'OxCaml switch detected: build with --profile oxcaml' >&2; exit 1;; esac")))

(rule
 (alias default)
 (enabled_if
  (= %{profile} oxcaml))
 (action
  (run sh -c
    "case \"$(ocamlc -version)\" in *+ox*) : ;; *) echo 'Profile oxcaml on a stock switch would silently skip the tests and demo: drop --profile oxcaml' >&2; exit 1;; esac")))
