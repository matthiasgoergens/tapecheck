diff --git a/staged-ocaml/dual-smoke/dual_smoke.ml b/staged-ocaml/dual-smoke/dual_smoke.ml
new file mode 100644
index 0000000..95be7ae
--- /dev/null
+++ b/staged-ocaml/dual-smoke/dual_smoke.ml
@@ -0,0 +1,50 @@
+open Fast_gen
+
+module Direct = Staged_generator.MakeStaged(C_sr_dropin_random)
+module Observed = Staged_generator.MakeStaged(Sr_random)
+
+let generate generator state =
+  Base_quickcheck.Generator.generate generator ~size:20 ~random:state
+
+let active_state seed =
+  Splittable_random.with_intercept
+    (Splittable_random.State.of_int seed)
+    (Splittable_random.Intercept.create ())
+
+let counting_active_state count seed =
+  let bool state ~default =
+    incr count;
+    default state
+  in
+  Splittable_random.with_intercept
+    (Splittable_random.State.of_int seed)
+    (Splittable_random.Intercept.create ~bool ())
+
+let fast_gen_cmi_path =
+  let build_root = Sys.executable_name |> Filename.dirname |> Filename.dirname in
+  Filename.concat build_root "lib/.fast_gen.objs/byte"
+
+let () =
+  let direct = Direct.return (Direct.C.lift 1) |> Direct.compile in
+  let observed = Observed.return (Observed.C.lift 2) |> Observed.compile in
+  let generator = Staged_generator.jit_dual ~direct ~observed () in
+  assert (generate generator (Splittable_random.State.of_int 1) = 1);
+  assert (generate generator (active_state 1) = 2)
+
+let () =
+  let direct = Direct.compile Direct.bool in
+  let observed = Observed.compile Observed.bool in
+  let generator =
+    Staged_generator.jit_dual
+      ~extra_cmi_paths:[fast_gen_cmi_path]
+      ~direct
+      ~observed
+      ()
+  in
+  let observed_draws = ref 0 in
+  for seed = 0 to 99 do
+    let direct = generate generator (Splittable_random.State.of_int seed) in
+    let observed = generate generator (counting_active_state observed_draws seed) in
+    assert (Bool.equal direct observed)
+  done;
+  assert (!observed_draws = 100)
