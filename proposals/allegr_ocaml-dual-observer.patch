@@ -8,0 +9,35 @@ let () = Runnative.add_search_path ((Util.run_ocamlfind_query "base") ^ " -O3 -w
+type 'a compiled = {
+  run : (size:int -> random:Splittable_random.State.t -> 'a) code;
+  dep_paths : string list;
+}
+
+let add_search_paths paths =
+  List.iter (fun path ->
+      if Hashtbl.mem search_paths path then ()
+      else
+        Hashtbl.add search_paths path ();
+        Runnative.add_search_path path
+    ) paths
+
+let to_bq_dual ~direct ~observed =
+  let direct_run = direct.run in
+  let observed_run = observed.run in
+  .<
+    let direct = .~direct_run in
+    let observed = .~observed_run in
+    Base_quickcheck.Generator.create (fun ~size ~random ->
+      if Splittable_random.Intercept.is_active random
+      then observed ~size ~random
+      else direct ~size ~random)
+  >.
+
+let print_dual ~direct ~observed =
+  Codelib.print_code Format.std_formatter (to_bq_dual ~direct ~observed)
+
+let jit_dual ?extra_cmi_paths ~direct ~observed () =
+  let extra_cmi_paths = List.flatten (Option.to_list extra_cmi_paths) in
+  add_search_paths extra_cmi_paths;
+  add_search_paths direct.dep_paths;
+  add_search_paths observed.dep_paths;
+  Runnative.run_native (Codelib.close_code (to_bq_dual ~direct ~observed))
+
