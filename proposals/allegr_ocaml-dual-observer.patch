+  -> observed:'a compiled
+  -> 'a Base_quickcheck.Generator.t Codelib.code
+
+val print_dual : direct:'a compiled -> observed:'a compiled -> unit
+
+val jit_dual
+  :  ?extra_cmi_paths:string list
+  -> direct:'a compiled
+  -> observed:'a compiled
+  -> unit
+  -> 'a Base_quickcheck.Generator.t
+
