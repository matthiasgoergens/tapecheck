+
+module Intercept = struct
+  type t = State.intercept
+
+  let create
+    ?(int64 = fun state ~lo ~hi ~default -> default state ~lo ~hi)
+    ?(float = fun state ~lo ~hi ~default -> default state ~lo ~hi)
+    ?(unit_float = fun state ~default -> default state)
+    ?(bool = fun state ~default -> default state)
+    ?(on_split = fun () -> None)
+    ?(on_perturb = fun _ -> None)
+    ()
+    =
+    { State.int64 = int64; float; unit_float; bool; on_split; on_perturb }
+
+  let is_active state = Option.is_some state.State.intercept
+end
+
+let with_intercept state intercept =
+  let state = State.copy state in
+  state.State.intercept <- Some intercept;
+  state
diff --git a/src/splittable_random.mli b/src/splittable_random.mli
index 1f7d6ea..08cab2f 100644
--- a/src/splittable_random.mli
+++ b/src/splittable_random.mli
@@ -48,0 +49,29 @@ end
+module Intercept : sig
+  type t
+
+  val create
+    :  ?int64:
+         (State.t
+          -> lo:int64
+          -> hi:int64
+          -> default:(State.t -> lo:int64 -> hi:int64 -> int64)
+          -> int64)
+    -> ?float:
+         (State.t
+          -> lo:float
+          -> hi:float
+          -> default:(State.t -> lo:float -> hi:float -> float)
+          -> float)
+    -> ?unit_float:(State.t -> default:(State.t -> float) -> float)
+    -> ?bool:(State.t -> default:(State.t -> bool) -> bool)
+    -> ?on_split:(unit -> t option)
+    -> ?on_perturb:(int -> t option)
+    -> unit
+    -> t
+
+  val is_active : State.t -> bool
+end
+
+(** Return a snapshot copy of [state] whose draws consult [intercept]. *)
+val with_intercept : State.t -> Intercept.t -> State.t
+
