new file mode 100644
index 0000000..854e151
--- /dev/null
+++ b/seam-smoke/seam_smoke.ml
@@ -0,0 +1,67 @@
+let () =
+  let bools = ref 0 in
+  let int64s = ref 0 in
+  let floats = ref 0 in
+  let unit_floats = ref 0 in
+  let hooks =
+    Splittable_random.Intercept.create
+      ~bool:(fun state ~default -> incr bools; default state)
+      ~int64:(fun state ~lo ~hi ~default ->
+        incr int64s;
+        default state ~lo ~hi)
+      ~float:(fun state ~lo ~hi ~default ->
+        incr floats;
+        default state ~lo ~hi)
+      ~unit_float:(fun state ~default -> incr unit_floats; default state)
+      ()
+  in
+  let state =
+    Splittable_random.with_intercept (Splittable_random.State.of_int 1) hooks
+  in
+  ignore (Splittable_random.bool state : bool);
+  ignore (Splittable_random.int64 state ~lo:0L ~hi:10L : int64);
+  ignore (Splittable_random.float state ~lo:0. ~hi:1. : float);
+  ignore (Splittable_random.unit_float state : float);
+  assert (!bools = 1);
+  assert (!int64s = 1);
+  assert (!floats = 1);
+  assert (!unit_floats = 1)
+
+let () =
+  let child_bools = ref 0 in
+  let child_hooks =
+    Splittable_random.Intercept.create
+      ~bool:(fun state ~default -> incr child_bools; default state)
+      ()
+  in
+  let parent_hooks =
+    Splittable_random.Intercept.create ~on_split:(fun () -> Some child_hooks) ()
+  in
+  let parent =
+    Splittable_random.with_intercept
+      (Splittable_random.State.of_int 2)
+      parent_hooks
+  in
+  let child = Splittable_random.State.split parent in
+  assert (Splittable_random.Intercept.is_active child);
+  ignore (Splittable_random.bool child : bool);
+  assert (!child_bools = 1);
+  let salt = ref None in
+  let perturb_bools = ref 0 in
+  let replacement =
+    Splittable_random.Intercept.create
+      ~bool:(fun state ~default -> incr perturb_bools; default state)
+      ()
+  in
+  let initial =
+    Splittable_random.Intercept.create
+      ~on_perturb:(fun value -> salt := Some value; Some replacement)
+      ()
+  in
+  let state =
+    Splittable_random.with_intercept (Splittable_random.State.of_int 3) initial
+  in
+  Splittable_random.State.perturb state 37;
+  assert (!salt = Some 37);
+  ignore (Splittable_random.bool state : bool);
+  assert (!perturb_bools = 1)
