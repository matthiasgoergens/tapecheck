diff --git a/src/generator.ml b/src/generator.ml
index 2146854..46898f1 100644
--- a/src/generator.ml
+++ b/src/generator.ml
@@ -569,11 +569,43 @@ module%template For_integer (Integer : Int_with_random) = struct
   ;;
 
   let non_uniform f lo hi =
-    (weighted_union [@mode portable])
-      [ 0.05, (return [@mode portable]) lo
-      ; 0.05, (return [@mode portable]) hi
-      ; 0.9, f lo hi
-      ]
+    (* Draw the branch selector FIRST, always draw the general value, and
+       order the branches lo / general / hi.
+
+       The branch distribution is unchanged, by count rather than by
+       assertion: over the 2^53-point selector grid both formulations
+       send 450359962737050 selectors to lo, 450359962737050 to hi and
+       8106479329266892 to general.
+
+       Which selector reaches which branch does change, on whole
+       intervals: stock's cumulative weights are [0.05; 0.10; 1.0], so
+       hi occupies (0.05, 0.10], where here it occupies [0.95, 1). That
+       is the intended effect -- it is what lets position 0 order lo <
+       general < hi. It is visible only to something that forces a
+       selector value; the sampler itself never returns 1.0.
+
+       What changes materially is how the draws are RECORDED, which
+       matters to any tool that reduces a counterexample by editing the
+       recorded choice sequence.
+
+       Previously [return lo] and [return hi] drew nothing further while
+       [f lo hi] drew more, so [int] reached max_value through a shorter
+       recording than it reached 1 by. Shortlex ordering is length-first,
+       so the extreme values ranked BELOW the small ones and reduction
+       settled on them. Equal draw counts fix that; drawing the selector
+       first, with hi last, then makes position 0 impose lo < general <
+       hi, which is the intended order.
+
+       Cost: [f lo hi] is now always generated from, i.e. two extra PRNG
+       calls in the 10% of draws that previously took a shortcut. *)
+    let general = f lo hi in
+    let selector =
+      (create [@mode portable]) (fun ~size:_ ~random ->
+        Splittable_random.float random ~lo:0. ~hi:1.)
+    in
+    (bind [@mode portable]) selector ~f:(fun p ->
+      (map [@mode portable]) general ~f:(fun v ->
+        if Float.( < ) p 0.05 then lo else if Float.( < ) p 0.95 then v else hi))
   ;;
 
   let inclusive = non_uniform uniform_inclusive
