opam-version: "2.0"
version: "v0.17.1+tapecheck"
synopsis: "Base_quickcheck with opt-in structural generators"
description: """
Tapecheck's source-compatible replacement for base_quickcheck v0.17.1.
It builds against the matching observed splittable_random pin and adds opt-in
structural generators while retaining the existing generator entry points.
"""
maintainer: "Matthias Goergens <matthiasgoergens@gmail.com>"
authors: ["Jane Street Group, LLC" "Matthias Goergens"]
license: "MIT"
homepage: "https://github.com/matthiasgoergens/tapecheck"
bug-reports: "https://github.com/matthiasgoergens/tapecheck/issues"
dev-repo: "git+https://github.com/matthiasgoergens/tapecheck.git"
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml"             {>= "5.3.0"}
  "dune"              {>= "3.11"}
  "base"              {>= "v0.17" & < "v0.18~"}
  "splittable_random" {= "v0.17.0+tapecheck"}
  "ppx_base"          {>= "v0.17" & < "v0.18~"}
  "ppx_fields_conv"   {>= "v0.17" & < "v0.18~"}
  "ppx_let"           {>= "v0.17" & < "v0.18~"}
  "ppx_sexp_message"  {>= "v0.17" & < "v0.18~"}
  "ppx_sexp_value"    {>= "v0.17" & < "v0.18~"}
  "ppxlib"            {>= "0.36.0"}
  "ppxlib_jane"       {>= "v0.17" & < "v0.18~"}
]
